{
  // The Node half of the repo: the Vite config and the notify endpoint it
  // mounts. Kept apart from tsconfig.json so `process`, `Buffer` and the rest of
  // the Node globals stay out of scope in the browser code, where reaching for
  // one is a bug rather than a convenience.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server", "vite.config.ts"]
}
