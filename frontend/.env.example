# Copy to `.env` and fill in. `.env` is gitignored — the real key never lands in git.

# Resend API key with "Sending access" permission — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Until a domain is verified in Resend, `onboarding@resend.dev`
# is the only usable sender and it only delivers to the account owner's address.
QC_MAIL_FROM=QC Platform <onboarding@resend.dev>

# Optional blind copy for every assignment notice.
QC_MAIL_BCC=

# OpenAI key for the assistant — https://platform.openai.com/api-keys
# Set a usage limit on the project: /api/chat is unauthenticated, like the
# notify endpoint, so anyone who finds the deployed URL can spend it.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxx

# Model to answer with. Must be one of the allowlist in `server/chat.ts`:
# gpt-5-mini (default) · gpt-5 · gpt-4.1-mini · gpt-4o-mini
# Anything else falls back to the default rather than failing.
#
# gpt-5* reason before answering: better at multi-step questions, but slower and
# billed for tokens you never see. gpt-4.1-mini answers this app's lookups
# nearly as well for less.
OPENAI_MODEL=gpt-5-mini

# Only needed when the key belongs to more than one organisation or project.
# Left blank the headers are not sent at all.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
