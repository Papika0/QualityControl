# Copy to `.env` and fill in. `.env` is gitignored — the real key never lands in git.

# Resend API key with "Sending access" permission — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Until a domain is verified in Resend, `onboarding@resend.dev`
# is the only usable sender and it only delivers to the account owner's address.
QC_MAIL_FROM=QC Platform <onboarding@resend.dev>

# Optional blind copy for every assignment notice.
QC_MAIL_BCC=

# OpenAI key for the assistant — https://platform.openai.com/api-keys
# Set a usage limit on the project: /api/chat is unauthenticated, like the
# notify endpoint, so anyone who finds the deployed URL can spend it.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxx

# Model to answer with. Must be one of the allowlist in `server/chat.ts`:
# gpt-4.1-mini (default) · gpt-5 · gpt-5-mini · gpt-4o-mini
# Anything else falls back to the default rather than failing.
#
# Picked on Georgian, which is what these answers are read in:
#   gpt-4.1-mini  clean Georgian, correct links, no reasoning bill.  ← default
#   gpt-5         the best writing here, ~4× the cost.
#   gpt-5-mini    inverts its own meaning (`შეაჩერე` where it means `დაიწყე`)
#                 and invents words. Raising OPENAI_REASONING_EFFORT does not
#                 fix it — it only changes which sentence is wrong.
#   gpt-4o-mini   cheapest, but writes absolute URLs the app then won't link.
OPENAI_MODEL=gpt-4.1-mini

# How hard a gpt-5* model thinks before answering: minimal · low (default) ·
# medium · high. Ignored by the non-reasoning models.
#
# Do not set this to `minimal`. Measured over repeated runs it answers in broken
# Georgian and mixes in characters from other scripts (CJK, Cyrillic); `low` was
# clean every time. Georgian is a low-resource language for these models and it
# is the first thing to go when they are told not to think.
OPENAI_REASONING_EFFORT=low

# Only needed when the key belongs to more than one organisation or project.
# Left blank the headers are not sent at all.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
