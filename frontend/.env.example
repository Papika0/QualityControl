# Copy to `.env` and fill in. `.env` is gitignored — the real key never lands in git.

# Resend API key with "Sending access" permission — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Until a domain is verified in Resend, `onboarding@resend.dev`
# is the only usable sender and it only delivers to the account owner's address.
QC_MAIL_FROM=QC Platform <onboarding@resend.dev>

# Optional blind copy for every assignment notice.
QC_MAIL_BCC=

# OpenRouter key for the assistant — https://openrouter.ai/keys
# Set a spending limit on it: /api/chat is unauthenticated, like the notify
# endpoint, so anyone who finds the deployed URL can spend it.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx

# Model to answer with. Must be one of the allowlist in `server/chat.ts`:
# openai/gpt-5-mini (default) · openai/gpt-5 · openai/gpt-4.1-mini · openai/gpt-4o-mini
# Anything else falls back to the default rather than failing.
OPENROUTER_MODEL=openai/gpt-5-mini

# Attribution shown on the OpenRouter dashboard. Neither is required.
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE=QC Platform
